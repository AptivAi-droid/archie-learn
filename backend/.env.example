#--------------------------------------------------------------------
# Archie Learn API — environment template
# Copy to `.env` (never commit `.env`) and fill in. On cPanel: chmod 600 .env
#--------------------------------------------------------------------

# development | production   (testing is set by PHPUnit)
CI_ENVIRONMENT = production

# Public URL of the API, with trailing slash
app.baseURL = 'https://api.archielearn.co.za/'
# Set true on production (redirects HTTP -> HTTPS)
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE (MySQL, InnoDB, utf8mb4)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = archie
database.default.username = archie_app
database.default.password =
database.default.DBDriver = MySQLi
database.default.port     = 3306

# Test database (PHPUnit only — wiped by the test suite!)
# database.tests.hostname = 127.0.0.1
# database.tests.database = archie_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.port     = 3306

#--------------------------------------------------------------------
# CORS — comma-separated list of frontend origins (no trailing slash, no *)
#--------------------------------------------------------------------
cors.allowedOrigins = https://aptivai-droid.github.io,http://localhost:5173

#--------------------------------------------------------------------
# FRONTEND — base URL of the web app (used in password-reset links)
#--------------------------------------------------------------------
FRONTEND_URL = https://aptivai-droid.github.io/archie-learn/

#--------------------------------------------------------------------
# CLAUDE (Anthropic)
#--------------------------------------------------------------------
ANTHROPIC_API_KEY =
# Optional: override the API host (default https://api.anthropic.com)
# ANTHROPIC_BASE_URL = https://api.anthropic.com
# Seconds before a Claude request times out (default 60)
# CLAUDE_TIMEOUT = 60

#--------------------------------------------------------------------
# LIMITS
#--------------------------------------------------------------------
# Tutor chat messages per learner per hour
CHAT_RATE_LIMIT = 30
# Practice answers marked per learner per hour
MARK_RATE_LIMIT = 60
# Login/register/password attempts per IP per minute
THROTTLE_AUTH_PER_MINUTE = 10
# Access-token lifetime in days
TOKEN_LIFETIME_DAYS = 30

#--------------------------------------------------------------------
# EMAIL (password reset). Leave email.fromEmail empty to disable sending;
# in development the reset link is then written to writable/logs at info level.
#--------------------------------------------------------------------
email.fromEmail  = no-reply@archielearn.co.za
email.fromName   = Archie Learn
email.protocol   = smtp
email.SMTPHost   = mail.archielearn.co.za
email.SMTPUser   = no-reply@archielearn.co.za
email.SMTPPass   =
email.SMTPPort   = 587
email.SMTPCrypto = tls

#--------------------------------------------------------------------
# ENCRYPTION (generate with: php spark key:generate)
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# LOGGING (production: 4 = errors and above; development: 9 = everything)
#--------------------------------------------------------------------
logger.threshold = 4
