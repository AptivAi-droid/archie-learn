# Archie Learn web app — build-time environment (Vite inlines VITE_* into the bundle,
# so never put secrets here; the Anthropic key lives only in backend/.env).

# ─── API ─────────────────────────────────────────────────────────────────────
# Origin of the CodeIgniter REST API (no trailing /api/v1 — the app appends it).
# REQUIRED for production builds, e.g. https://api.archielearn.co.za
# Defaults to http://localhost:8080 (`php spark serve`) when unset.
VITE_API_URL=http://localhost:8080

# ─── Base path ───────────────────────────────────────────────────────────────
# Set by CI to build the dev branch under /archie-learn/dev/ (default /archie-learn/).
# VITE_BASE_PATH=/archie-learn/dev/

# ─── Demo mode (sales demos only) ────────────────────────────────────────────
# When "true", triple-tapping the Tutor logo toggles canned demo answers.
# Leave unset (or anything other than "true") for every real build — students
# must never receive canned answers, and any stored demo flag is ignored.
# VITE_ALLOW_DEMO=false
